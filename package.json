{
  "name": "derp-worker",
  "private": true,
  "type": "module",
  "license": "BSD-3-Clause",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit && tsc --noEmit -p test && tsc --noEmit -p examples/admission",
    "lint": "eslint .",
    "format": "prettier --write .",
